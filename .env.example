# 大模型：DeepSeek 官方 API（OpenAI 兼容协议）
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# 业务查询默认关闭思考，降低响应耗时。
LLM_THINKING=disabled
LLM_STREAMING=1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1

# 本机文档解析：扫描件、图片、复杂PDF使用独立MinerU环境
DOCUMENT_PDF_PARSER=auto
MINERU_PYTHON=./.venv-mineru/bin/python
MINERU_TIER=basic
MINERU_TIMEOUT=300

# Context Harness（default 可切回 DeepAgents 原生策略）
CONTEXT_STRATEGY=selective
CONTEXT_WINDOW=32768
CONTEXT_OUTPUT=4096
CONTEXT_SAFETY=1024
CONTEXT_TRIGGER=0.85
CONTEXT_TARGET=0.70

# Tavily 联网搜索
TAVILY_API_KEY=

# 内部知识库（本地向量检索）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_PATH=./models/Qwen3-Embedding-0.6B
# 默认CPU；Apple GPU可设mps，NVIDIA GPU可设cuda
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=4
KNOWLEDGE_BASE_DIR=./知识库文件/90_公司文档
# 向量库位置。相对路径会基于项目根解析；若要放到项目之外，必须用当前系统的绝对路径写法
# （macOS/Linux 用 /Users/xxx/...，Windows 的 C:/... 在 POSIX 上会被当作相对路径）。
VECTOR_STORE_DIR=./data/department/company-vector-store

# 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3300
MYSQL_USER=tanyuan_reader
MYSQL_PASSWORD=
MYSQL_DATABASE=department_workbench
MYSQL_CHARSET=utf8mb4

# docker compose 开发库 root 密码（仅初始化使用，与应用只读账号分开）
MYSQL_DEV_ROOT_PASSWORD=

# 默认跨平台转换；Windows 可设为 word（需 Office）
PDF_BACKEND=reportlab
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1
# 通用内容分项审查总等待时间（秒），范围1～60；失败不冒充通过
CONTENT_REVIEW_TIMEOUT=20

# 单任务总超时（秒）。任务被取消/超时会推送 error 事件。
TASK_TIMEOUT=900
# 每轮检索上限：网络检索对应 PRD BR-03（最多 3 次）；知识库为运行护栏。
WEB_SEARCH_LIMIT=3
KNOWLEDGE_SEARCH_LIMIT=6
# 每次调用最多跳数（程序限制 1-4）；每跳计入上面的会话/轮次预算
KNOWLEDGE_MAX_HOPS=3
KNOWLEDGE_REVIEW_TIMEOUT=20
# BM25 词元覆盖门槛与归一化向量 L2 距离门槛，需要按本地语料评估校准
KNOWLEDGE_MIN_LEXICAL_OVERLAP=0.08
KNOWLEDGE_MAX_VECTOR_DISTANCE=0.8

# 容器/本地服务端口
APP_PORT=8000

# 反向代理 / TLS
APP_DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
# 本地用 deploy/Caddyfile；生产改为 deploy/Caddyfile.prod，并把端口改为 80/443
CADDYFILE=./deploy/Caddyfile
ACME_EMAIL=

# 业务数据导入专用账号，仅需目标业务库的 SELECT、INSERT 权限。
# 与 MYSQL_USER（聊天查询只读账号）分开；留空时可预览校验，禁止正式写入。
MYSQL_IMPORT_USER=
MYSQL_IMPORT_PASSWORD=
# 暂存文件、导入预览、历史状态；默认 data/imports
# IMPORT_STORAGE_DIR=

# 本地业务记录维护：独立账号，不复用只读查询/导入账号
MYSQL_EDIT_ENABLED=0
MYSQL_EDIT_USER=
MYSQL_EDIT_PASSWORD=
MYSQL_EDIT_AUDIT_DATABASE=tanyuan_management

# 可选：服务端导入连接白名单JSON路径；未配置时仅默认业务库
IMPORT_CONNECTIONS_FILE=

# 可选本地SQL控制台，独立账号；只对当前业务库开放DDL/DML，不用于智能体。
MYSQL_CONSOLE_ENABLED=0
MYSQL_CONSOLE_USER=
MYSQL_CONSOLE_PASSWORD=

# 部门共享盘工作台（原件只读；激活脚本会建立独立department_workbench）
# 默认业务库为department_workbench；运行激活脚本后使用独立的部门账号。
DATA_MODE=demo
# 真实内网设intranet，并将DEEPSEEK_BASE_URL改成内网OpenAI兼容推理端点
LOCAL_MODEL_HOSTS=
CASEWORK_DB_PATH=./data/department/casework.db
CASEWORK_ALLOWED_ROOTS=[]
CASEWORK_EMBEDDING=1
CASEWORK_EMBEDDING_MODEL_PATH=
# 按本地Embedding Tokenizer计数；按章节/句子切分并保留原文位置
CASEWORK_CHUNK_STRATEGY=tokens
CASEWORK_CHUNK_TOKENS=320
CASEWORK_CHUNK_OVERLAP=48
# 默认CPU；本机有Apple GPU可显式设mps，有NVIDIA GPU可设cuda
CASEWORK_RERANKER_DEVICE=cpu
CASEWORK_RERANKER_MODEL_PATH=./models/bge-reranker-base
CASEWORK_RERANKER_MAX_TOKENS=512
CASEWORK_RERANKER_BATCH_SIZE=4
CASEWORK_RERANKER_CANDIDATES=20
# 2026-11-05开发集校准；换语料或候选策略后需重新评估
CASEWORK_RERANKER_MIN_LOGIT=-0.8682041168212891
CASEWORK_MYSQL_MIRROR=0
MYSQL_CASEWORK_SYNC_USER=
MYSQL_CASEWORK_SYNC_PASSWORD=
CASEWORK_SYNC_INTERVAL=0
CASEWORK_MAX_FILES=20000
# 对完整匹配的受支持问句使用程序契约。
CASEWORK_PROGRAM_CONTRACTS=1
# 已取得证据的相关性审查并发上限；设1顺序执行，固定取数始终保持同快照顺序。
CASEWORK_PARALLEL_REVIEW=2
