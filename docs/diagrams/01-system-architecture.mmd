flowchart TB
    U["用户：代理师 / Boss"] --> UI["Vue 3 工作台<br/>案件 · 会话 · 文件 · 数据管理"]
    UI <-->|"HTTP / WebSocket"| API["FastAPI<br/>任务、会话、证据与文件接口"]
    API --> CW["案件工作台服务<br/>筛选 · 会议 · 月报 · 分案确认"]
    API --> R["任务路由与权限上限<br/>意图参数 · 来源选择 · 执行预算"]
    R --> F["固定业务流程<br/>受限参数 → 查询 / 统计 → 业务契约"]
    R --> A["DeepAgents 主智能体<br/>任务规划 · 工具调度 · 报告整理"]
    A --> SUB["数据库 / 知识库 / 联网子智能体"]
    A --> FILE["会话附件读取与报告工具"]
    F --> FT["部门只读工具<br/>案件 · 会议 · 月报 · 规则推荐 · 案卷检索"]
    SUB --> T["按计划开放的工具<br/>受控 SQL · 案卷 / 知识检索 · Tavily"]
    FT --> E
    T --> E["证据记录<br/>来源编号 · 原文位置 · 版本 · 查询结果"]
    FILE --> E
    E --> V["结果核验<br/>程序复算 · 引用与产物检查 · 对应任务审查"]
    V --> OUT["回答 / 图表 / Markdown / PDF<br/>执行历史与未达标项"]
    OUT --> API
    CW --> DATA[("SQLite 目录与审计<br/>MySQL 结构化投影<br/>本地正文与知识索引")]
    FT --> DATA
    T --> DATA
