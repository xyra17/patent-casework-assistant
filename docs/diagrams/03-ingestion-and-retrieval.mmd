    CASE --> CE["案件命中 + 原文证据"]
    K["普通知识库文档"] --> CHUNK["多格式解析与分块"]
    CHUNK --> HYBRID["本地 Qwen3 / Chroma + BM25<br/>RRF 融合 + 轻量确定性重排"]
    HYBRID --> HOP["有限多跳<br/>覆盖检查 / 缺口 / 停止原因"]
