flowchart TB
    subgraph BUILD["文档入库 / 索引构建"]
        S["共享盘原件：增量扫描与内容版本"] --> P["案件文件解析"]
        P --> F["字段与会议抽取"]
        P --> B["案卷分块与 Qwen3 向量化"]
        F --> CASE[("案件 SQLite：候选 / 冲突 / 确认；可选 MySQL 投影")]
        B --> BODY[("案件 SQLite：正文、向量、文件与解析版本")]
        K["公司文档上传与版本管理"] --> KP["解析、分块与 Qwen3 向量化"]
        KP --> KI[("Chroma / 分块侧文件 / 版本快照")]
    end
    subgraph READ["在线查询与材料收集：按任务选用"]
        CASE --> CQ["单案字段、筛选清单、统计与负荷"]
        CQ --> CO["结构化结果与来源引用"]
        BODY --> R["Qwen3 + BM25 + 技术别名 / RRF"]
        R --> RR["条件重排、按案归并；按需 bge-reranker-base"]
        RR --> RO["候选案件、原文片段、同案附件"]
        CO -->|会前卡| PACK["按案材料包：文件清单、已发布正文、版本、范围与缺项"]
        BODY -.->|按案读取已发布材料| PACK
        KI --> KR["公司文档混合召回与轻量重排"]
        KR --> KH["按需覆盖检查与有限补查"]
        KH -.->|继续补查| KR
        KH --> KO["知识片段、原文位置与版本"]
    end
    CO --> E["任务证据登记、同版本复用与原文回读"]
    PACK --> E
    RO --> E
    KO --> E
